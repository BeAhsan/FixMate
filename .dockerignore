# Keep build context lean and secrets out of the image.
.git
.gitignore
.github

# Installed by the image's own stages — never copy from the host.
node_modules
vendor

# Built inside the image by the assets stage.
public/build
public/hot
public/fonts-manifest.dev.json

# Secrets
.env
.env.*
!.env.example
/auth.json

# Local dev state
/.phpunit.cache
/.phpunit.result.cache
/.idea
/.vscode
/.zed
/.nova
/.cursor
/.codex
/storage/*.key
/storage/pail
/storage/logs/*
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*
/database/*.sqlite

# CI + orchestration files are not needed at runtime.
Jenkinsfile
docker-compose*.yml
deploy/
README.md
AGENTS.md
CLAUDE.md
*.md
/.opencode
/.claude

.DS_Store
Thumbs.db
