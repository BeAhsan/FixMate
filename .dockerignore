# Keep build context lean and secrets out of the image.
.git
.gitignore
.github

# Installed by the image's own stages — never copy from the host.
vendor

# Secrets
.env
.env.*
!.env.example
/auth.json

# Local dev state
/.phpunit.cache
/.phpunit.result.cache
/.idea
/.vscode
/.zed
/.nova
/.cursor
/.codex
/storage/*.key
/storage/pail
/storage/logs/*
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*
/database/*.sqlite

# CI + orchestration files are not needed at runtime.
Jenkinsfile
docker-compose*.yml
deploy/
README.md
AGENTS.md
CLAUDE.md
# `*.md` only matches at the root, so nested docs need this or they ship in the
# image via `COPY . .` in the vendor stage.
*.md
/docs
/.opencode
/.claude

.DS_Store
Thumbs.db

# npm workspaces. node_modules is huge and reinstalled by the front-end images;
# the generated typed client is produced fresh by `php artisan
# api-client:generate` in the container, so copying a host copy in would defeat
# the point. packages/api-client/contract.json, packages/api-client/openapi.json
# and src/ DO ship: the two drift checks read them out of this image, so
# excluding either of those two JSON files would make `api-client:check` and
# `api-docs:check` pass in the repository and fail in the pipeline.
node_modules
packages/*/src/generated
