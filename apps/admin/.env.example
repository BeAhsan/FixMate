# The back end's address, inlined into the static export at build time.
#
# Copy to `.env.local` to point a host build somewhere other than
# http://localhost:8000 — the address `config/applications.php` names for this
# application, and the value `npm run build` uses when nothing is set.
#
# The Docker image does not read this file. It takes the address as a build
# argument, and it has no default, so omitting it fails the build rather than
# producing an image pointing at localhost:
#
#   docker build -f apps/user/Dockerfile \
#     --build-arg NEXT_PUBLIC_API_URL=https://api.example.test \
#     -t fixmate/user-app:<sha> .
#
# There is no secret here and nothing sensitive belongs in this file: the value
# is inlined into a JavaScript bundle that every browser downloads.
NEXT_PUBLIC_API_URL=http://localhost:8000
