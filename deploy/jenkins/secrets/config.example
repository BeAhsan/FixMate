# Jenkins controller configuration, read by init.groovy.d/20-create-job.groovy
# on startup. Copy this file to `config` in the same directory and fill it in.
#
#   cp deploy/jenkins/secrets/config.example deploy/jenkins/secrets/config
#
# Every value here is a single line. Multi-line material (the SSH private key,
# the known_hosts pin) lives in its own file next to this one.
#
# This file is safe to commit once filled in: it holds no secrets. The files
# that DO hold secrets are listed at the bottom and must never be committed.

# --- What to build and deploy -----------------------------------------------

# The repository Jenkins checks out. Must be reachable from this server.
REPO_URL=https://github.com/BeAhsan/FixMate.git

# The branch to build. Production deploys are gated on this being main.
BRANCH=main

# Image coordinates. TAG is supplied by the pipeline (the commit SHA).
IMAGE_REPO=ghcr.io/beahsan/fixmate/app

# Where to deploy. Must be reachable from this server over SSH.
DEPLOY_HOST=92.5.105.170
DEPLOY_USER=deploy
DEPLOY_DIR=/opt/fixmate

# Must match the CPU of DEPLOY_HOST: x86_64 -> linux/amd64, aarch64 -> linux/arm64.
# A mismatch does not fail the build, it fails on the target at container start.
PLATFORM=linux/amd64

# Optional. Checked from outside the VPS after a deploy. Leave empty to rely on
# the on-host health check alone.
SMOKE_URL=

# --- Optional ---------------------------------------------------------------

# Credential ID for cloning a PRIVATE repository. Leave empty for a public one.
# To use it, also create deploy/jenkins/secrets/git-user and git-token.
GIT_CREDENTIAL_ID=

# --- Secrets ----------------------------------------------------------------
# These live in separate files in this directory and are never committed.
# The init script skips everything below if they are absent, so Jenkins still
# boots and can be configured by hand instead.
#
#   registry-user     GitHub username for ghcr.io
#   registry-token    token with write:packages
#   ssh-key           private key for DEPLOY_USER@DEPLOY_HOST
#   known-hosts       output of: ssh-keyscan -H DEPLOY_HOST
#   git-user          (only for a private repo)
#   git-token         (only for a private repo)
