# Production environment for the VPS.
#
# Copy to /opt/fixmate/.env on the target server and fill in every value:
#
#   scp deploy/env.example <user>@<vps-host>:/opt/fixmate/.env
#   ssh <user>@<vps-host> 'chmod 600 /opt/fixmate/.env'
#
# This file is read two ways:
#   * by `docker compose` for variable substitution (${APP_IMAGE}, ${DB_*}, ...)
#   * by every app container via `env_file: .env`
#
# Never commit the filled-in copy. The repo's .gitignore already excludes .env.

# ---------------------------------------------------------------------------
# Image and public URL
# ---------------------------------------------------------------------------
# The pipeline overwrites APP_IMAGE per release; the value here is only the
# fallback used by a manual `docker compose up`.
APP_IMAGE=ghcr.io/beahsan/fixmate/app:latest

# Public URL. Used by the framework for generated links and password resets,
# so it must match the address users actually visit.
APP_URL=https://example.com

# Port the app is published on inside the VPS. Put a reverse proxy or load
# balancer in front of this and terminate TLS there; set to 8080 to keep 80 free.
APP_PORT=80

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Generate with: docker compose run --rm app php artisan key:generate --show
APP_KEY=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# DB_HOST/DB_PORT are fixed to the compose service names by
# docker-compose.prod.yml and must not be set here.
DB_DATABASE=fixmate
DB_USERNAME=fixmate
DB_PASSWORD=
DB_ROOT_PASSWORD=

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_MAXMEMORY=256mb

# ---------------------------------------------------------------------------
# Sessions, cache and queues
# ---------------------------------------------------------------------------
# Redis keeps these off the database and makes the cache shareable between
# web, queue and scheduler processes.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# stderr is collected by the Docker log driver.
LOG_CHANNEL=stderr
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
