# Production environment for the VPS.
#
# Copy to /opt/fixmate/.env on the target server and fill in every value:
#
#   scp deploy/env.example <user>@<vps-host>:/opt/fixmate/.env
#   ssh <user>@<vps-host> 'chmod 600 /opt/fixmate/.env'
#
# This file is read two ways:
#   * by `docker compose` for variable substitution (${APP_IMAGE}, ${DB_*}, the
#     four front-end images and ports, ...)
#   * by every app container via `env_file: .env`
#
# The four front ends do NOT read it. They are static exports: their one
# variable was inlined into the bundle at build time, so there is nothing left
# for a .env to set at run time.
#
# Never commit the filled-in copy. The repo's .gitignore already excludes .env.

# ---------------------------------------------------------------------------
# Image and public URL
# ---------------------------------------------------------------------------
# The pipeline overwrites APP_IMAGE per release; the value here is only the
# fallback used by a manual `docker compose up`.
APP_IMAGE=ghcr.io/beahsan/fixmate/app:latest

# Registry credentials for pulling APP_IMAGE, needed only if the package is
# private. The token needs `read:packages` and nothing more - the push happens
# from the Jenkins controller, which holds a separate, write-capable token.
#
# Leave both blank for a public image and the deploy skips logging in.
# REGISTRY_USER=your-github-username
# REGISTRY_TOKEN=github_pat_...

# Public URL. Used by the framework for generated links and password resets,
# so it must match the address users actually visit.
APP_URL=https://example.com

# The address the four front ends bake into their exports as the API they call.
# Required by docker-compose.prod.yml, and a DIFFERENT thing from APP_URL even
# though they are usually the same value: a front end is a browser-facing origin
# with its own port, and the API is what it calls. On a deployment that puts a
# reverse proxy in front of the two, they genuinely differ.
#
# It is a build input, not a runtime one, so it is here for the `docker compose
# build` path rather than for the running containers. It is interpolated when
# Compose reads this file, so leaving it unset fails the build immediately with
# the variable named - which is the point. A default would bake an address into
# an image, report success, and leave every request from that front end failing
# in the browser with nothing to show for it.
#
# Written as a reference to APP_URL rather than as a second literal, so the two
# cannot disagree on a deployment that wants them the same.
NEXT_PUBLIC_API_URL="${APP_URL}"

# Port the app is published on inside the VPS. 8080 keeps 80 free for the
# reverse proxy that should sit in front of this; the container speaks plain
# HTTP, so terminate TLS at the proxy.
APP_PORT=8080

# ---------------------------------------------------------------------------
# The four front ends
# ---------------------------------------------------------------------------
# One image and one published address each. The pipeline overwrites the image
# tags per release; these values are the fallback for a manual `up`.
#
# THE ADDRESSES MUST AGREE WITH config/applications.php ON THE BACK END. That
# file is the allowed-origins list, and a front end published on an address it
# does not name has every request refused by the browser before the back end is
# even asked. Adding or renaming an address is an edit in both places, and only
# in these two places - docker-compose.prod.yml reads the port from here and
# repeats nothing.
#
# The four must also differ from each other and from APP_PORT. Compose fails on
# a duplicate publish rather than silently picking one, so a collision surfaces
# when the stack starts.
USER_APP_IMAGE=ghcr.io/beahsan/fixmate/user-app:latest
USER_APP_PORT=3000

WORKER_APP_IMAGE=ghcr.io/beahsan/fixmate/worker-app:latest
WORKER_APP_PORT=3001

ADMIN_APP_IMAGE=ghcr.io/beahsan/fixmate/admin-app:latest
ADMIN_APP_PORT=3002

SUPER_ADMIN_APP_IMAGE=ghcr.io/beahsan/fixmate/super-admin-app:latest
SUPER_ADMIN_APP_PORT=3003

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# The application's own name.
#
# MAIL_FROM_NAME at the bottom of this file interpolates it, and that is the one
# place it is read today: config/mail.php takes `env('MAIL_FROM_NAME', ...)` and
# falls back to APP_NAME, then to 'Laravel'. Nothing in this codebase reads
# config('app.name') - the API serves no pages, so a page title is not a symptom
# to go looking for. Set it anyway: it is the variable Laravel documents, it is
# what the fallback chain wants, and it means a later consumer reads it correctly
# instead of inheriting 'Laravel'.
#
# It has to be HERE, in this file, and not only as a build argument. The image is
# immutable and gets its runtime configuration from this .env through `env_file`,
# so a value baked in at build time is not visible to it. This line was missing,
# and MAIL_FROM_NAME="${APP_NAME}" then resolved to an empty string rather than to
# the literal text - Compose interpolates it, it does not pass the text through -
# so the fallback chain never ran, every password-reset email went out with a
# blank From name, and the compose run warned on every invocation.
APP_NAME=FixMate

# Generate with: docker compose run --rm app php artisan key:generate --show
APP_KEY=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# DB_HOST/DB_PORT are fixed to the compose service names by
# docker-compose.prod.yml and must not be set here.
DB_DATABASE=fixmate
DB_USERNAME=fixmate
DB_PASSWORD=
DB_ROOT_PASSWORD=

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_MAXMEMORY=256mb

# ---------------------------------------------------------------------------
# Sessions, cache and queues
# ---------------------------------------------------------------------------
# Redis keeps these off the database and makes the cache shareable between
# web, queue and scheduler processes.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# stderr is collected by the Docker log driver.
LOG_CHANNEL=stderr
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
