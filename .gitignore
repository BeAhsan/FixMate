*.log
.DS_Store
.env
.env.backup
.env.production
.phpactor.json
.phpunit.result.cache
/.codex
/.cursor/
/.idea
/.nova
/.phpunit.cache
/.vscode
/.zed
/auth.json
# A separate checkout that sits alongside this one. Git cannot track the
# contents of a nested repository - it stores only a commit reference, so a
# clone of this repo would get an empty directory and a warning instead of the
# code - and plain `git add -A` adds it as a gitlink on every commit otherwise.
/Bonsai-demo
/public/storage
/storage/*.key
/storage/pail
/vendor
_ide_helper.php
Homestead.json
Homestead.yaml
Thumbs.db

# Jenkins controller secrets, filled in from deploy/jenkins/secrets/config.example
deploy/jenkins/secrets/*
!deploy/jenkins/secrets/config.example

# npm workspaces. Unanchored, because npm hoists a workspace's own
# node_modules into the package directory when there is a conflict.
/node_modules
node_modules

# The generated typed client. Produced fresh by `php artisan api-client:generate`
# in the build, never committed: a committed copy could go stale, which is the
# one failure this package exists to prevent.
packages/*/src/generated

# Front-end build output.
#
# Scoped to `apps/*` and `packages/*`, and the `out` line is the load-bearing
# one. A gitignore pattern with no slash matches at ANY depth, so a bare `out`
# would also match the `out/` at the repository root - which is not front-end
# output. It is an rsync test fixture committed to prove the `--delete` staging
# fix in the `Jenkinsfile`, and it would be silently untracked. The static
# export that collides with it is `apps/user/out`, per application, and that is
# the path below. The same trap is spelled out in .dockerignore, where the
# matching rule behaves differently again.
apps/*/.next
apps/*/out
packages/*/.next
packages/*/out

# Written by `next build` into the application's tsconfig cache.
apps/*/*.tsbuildinfo

# Written by `next build`, and it references `./.next/types/...`, which is also
# build output. Committing it therefore breaks `npm run typecheck` on a clean
# checkout, before anything has been built. The same is true of create-next-app's
# own template.
apps/*/next-env.d.ts

# Test runner caches
.vite
